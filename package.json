{
  "name": "autogherk",
  "version": "0.1.0",
  "description": "AI-powered CLI that generates BDD Gherkin test scenarios from product usage videos",
  "type": "module",
  "main": "./dist/api.js",
  "exports": {
    ".": "./dist/api.js",
    "./cli": "./dist/index.js"
  },
  "bin": {
    "autogherk": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "gherkin",
    "bdd",
    "testing",
    "ai",
    "video",
    "gemini",
    "claude",
    "cucumber",
    "specflow",
    "behave",
    "test-automation",
    "cli",
    "autogherk"
  ],
  "author": "Ashar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arizqi/autogherk"
  },
  "homepage": "https://github.com/arizqi/autogherk#readme",
  "bugs": {
    "url": "https://github.com/arizqi/autogherk/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@google/genai": "^1.48.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "ora": "^9.3.0",
    "playwright": "^1.52.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
